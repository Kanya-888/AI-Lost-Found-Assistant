# Server Settings
APP_NAME="AI Lost & Found Assistant"
ENV="development"
PORT=8000
SECRET_KEY="super-secret-jwt-key-please-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./lost_and_found.db"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Email Settings (Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM_NAME="AI Lost & Found System"

# AI & Vector Index Settings
MATCH_THRESHOLD=0.80
FAISS_INDEX_DIR="./embeddings/faiss_data"
UPLOAD_DIR="./uploads"
